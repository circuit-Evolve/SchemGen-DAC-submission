v {xschem version=3.4.4 file_version=1.2}
G {}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=X1"
spice_sym_def=".subckt schemgen_diso_amp INP INN OUT
* SchemGen ideal op-amp: Vout = 1e5 * (V(INP) - V(INN))
E1 OUT 0 INP INN 1e5
.ends schemgen_diso_amp"
}
V {}
S {}
E {}
L 4 -80 -20 -50 -20 {}
L 4 -80 20 -50 20 {}
L 4 50 0 80 0 {}
L 4 -50 -40 -50 40 {}
L 4 -50 -40 50 0 {}
L 4 -50 40 50 0 {}
L 4 -45 -20 -35 -20 {}
L 4 -40 -25 -40 -15 {}
L 4 -45 20 -35 20 {}
B 5 -82.5 -22.5 -77.5 -17.5 {name=INP dir=in}
B 5 -82.5 17.5 -77.5 22.5 {name=INN dir=in}
B 5 77.5 -2.5 82.5 2.5 {name=OUT dir=out}
T {@name} -45 -60 0 0 0.2 0.2 {}
